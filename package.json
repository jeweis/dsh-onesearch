{
  "name": "dsh-onesearch",
  "version": "0.1.0",
  "description": "一个搜索 (dsh-onesearch) for DeepSeek Harness: one search seam over ordered engines — per-engine switches, drag-order priority, and automatic fallback to the next engine when one fails. Takes over the default web search; exposes no vendor-named tools.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web-search",
    "meta-search",
    "fallback",
    "search-provider"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
